# Sao chép file này thành .env rồi sửa. KHÔNG commit file .env lên GitHub.
DATABASE_URL=postgresql+psycopg2://postgres:MATKHAU@localhost:5432/qr_order
SECRET_KEY=doi-thanh-chuoi-ngau-nhien-dai
# IP máy chạy server trong mạng LAN (xem bằng ipconfig), để điện thoại quét QR vào được
BASE_URL=http://192.168.1.10:5000
# Thư mục bin của PostgreSQL (chứa pg_dump và psql) nếu chưa có trong PATH, dùng cho sao lưu và phục hồi
# Windows ví dụ: PG_BIN_DIR=C:\Program Files\PostgreSQL\16\bin
PG_BIN_DIR=
# Thư mục lưu bản sao lưu (mặc định: thư mục backups cạnh run.py)
BACKUP_DIR=
